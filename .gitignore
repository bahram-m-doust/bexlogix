# Python cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.log

# Virtual environments
venv/
.venv/

# Database files
*.db
*.sqlite3
*.db-shm
*.db-wal

# Runtime output
output/
tmp/

# IDE and local settings
.idea/
.vscode/
.env

# OS files
.DS_Store
Thumbs.db

# Caches / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/

# Streamlit machine-specific
.streamlit/secrets.toml

# Local binary and office artifacts
~$*.xlsx
~$*.xls

# Keep sample Excel files local-only (security policy)
data/*.xlsx
data/*.xls

data/raw/
data/tmp/

# Keep only canonical docs tracked
*.md
!README.md
!DEPLOY.md
