{
  "version": 8,
  "name": "BexLogix Tehran Offline",
  "center": [51.41415, 35.70385],
  "zoom": 11,
  "glyphs": "{fontstack}/{range}.pbf",
  "sources": {
    "tehran": {
      "type": "vector",
      "url": "mbtiles://{tehran}"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {"background-color": "#e8edf2"}
    },
    {
      "id": "land",
      "type": "fill",
      "source": "tehran",
      "source-layer": "land",
      "paint": {"fill-color": "#f2f0ea"}
    },
    {
      "id": "water",
      "type": "fill",
      "source": "tehran",
      "source-layer": "water_polygons",
      "paint": {"fill-color": "#b9d9ee"}
    },
    {
      "id": "land-vegetation",
      "type": "fill",
      "source": "tehran",
      "source-layer": "land_vegetation",
      "paint": {
        "fill-color": "#dce9d4",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "tehran",
      "source-layer": "buildings",
      "minzoom": 14,
      "paint": {
        "fill-color": "#d9dde1",
        "fill-outline-color": "#c4cbd2"
      }
    },
    {
      "id": "street-areas",
      "type": "fill",
      "source": "tehran",
      "source-layer": "street_polygons",
      "minzoom": 11,
      "paint": {
        "fill-color": "#ffffff",
        "fill-opacity": 0.98,
        "fill-outline-color": "#d3d9df"
      }
    },
    {
      "id": "streets-casing",
      "type": "line",
      "source": "tehran",
      "source-layer": "streets",
      "minzoom": 14,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#b8c0c8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 3.8, 18, 11],
        "line-opacity": 0.9
      }
    },
    {
      "id": "streets",
      "type": "line",
      "source": "tehran",
      "source-layer": "streets",
      "minzoom": 14,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 2.7, 18, 9],
        "line-opacity": 1
      }
    },
    {
      "id": "bridges",
      "type": "line",
      "source": "tehran",
      "source-layer": "bridges",
      "minzoom": 12,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1.4, 14, 4.2]
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "tehran",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#9aa3ad",
        "line-width": 0.8,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "water-labels",
      "type": "symbol",
      "source": "tehran",
      "source-layer": "water_lines_labels",
      "minzoom": 11,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 9, 14, 12],
        "text-padding": 4
      },
      "paint": {
        "text-color": "#2875a7",
        "text-halo-color": "#eaf5fc",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "street-labels",
      "type": "symbol",
      "source": "tehran",
      "source-layer": "street_labels",
      "minzoom": 10,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"], ["get", "name_de"], ["get", "ref"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 9, 14, 12],
        "text-max-angle": 35,
        "text-padding": 3
      },
      "paint": {
        "text-color": "#344054",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "street-label-points",
      "type": "symbol",
      "source": "tehran",
      "source-layer": "street_labels_points",
      "minzoom": 12,
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"], ["get", "ref"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 9, 14, 11],
        "text-padding": 3
      },
      "paint": {
        "text-color": "#344054",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "public-transport-labels",
      "type": "symbol",
      "source": "tehran",
      "source-layer": "public_transport",
      "minzoom": 11,
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"], ["get", "ref"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 10,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#7b3f96",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "tehran",
      "source-layer": "place_labels",
      "minzoom": 8,
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"], ["get", "name_de"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 11, 14, 15],
        "text-padding": 8,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#1d2939",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    }
  ]
}
